---
// src/components/MobileHeader.astro
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm transition-all duration-300">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between">
    
    <a href="/" class="group flex flex-col justify-center">
      <div class="flex items-baseline gap-1.5">
        {/* H1 Tag Logic: Only display H1 on Homepage if it lacks a Hero H1, otherwise Div */}
        {/* Current design has semantic H1 on camp pages, so header needs to be Div */}
        <div class="font-black text-lg md:text-xl tracking-tight text-stone-800 group-hover:text-emerald-800 transition-colors">
          Outdoor Fun
        </div>
        
        {/* 已修正: TW 徽章使用深灰 */}
        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-stone-100 text-stone-800 border border-stone-200">
            TW
        </span>
      </div>

      <div class="flex items-center gap-2">
        {/* 已修正: Since 2004 使用深橘 */}
        <span class="flex items-center text-[10px] font-semibold text-emerald-700 tracking-wide uppercase">
          <span class="mr-1">🏄</span> Since 2005
        </span>
        <span class="hidden md:inline-block w-0.5 h-3 bg-stone-300"></span>
        
        {/* 🟢 [FIX] 對比度優化: text-stone-400 -> text-stone-600 */}
        {/* 字體很小(10px)，必須使用較深的灰色才能符合 WCAG AA 標準 */}
        <span class="text-[10px] text-stone-600 hidden md:inline-block">
          Best surf spots & forecast
        </span>
      </div>
    </a>

    <div class="flex items-center gap-3">
        <a href="/search" aria-label="搜尋浪點" class="p-2 text-stone-500 hover:bg-stone-100 rounded-full transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </a>
    </div>
  </div>
</header>