---
import 'leaflet/dist/leaflet.css';

interface Props {
  lat: number;
  lng: number;
  name: string;
}

const { lat, lng, name } = Astro.props;

// Server-side calculation for Static Tile (LCP Optimization)
// We calculate the center tile X/Y for the given lat/lng at zoom 15
const zoom = 15;
const latRad = lat * Math.PI / 180;
const n = Math.pow(2, zoom);
const xTile = Math.floor((lng + 180) / 360 * n);
const yTile = Math.floor((1 - Math.log(Math.tan(latRad) + 1 / Math.cos(latRad)) / Math.PI) / 2 * n);
const staticTileUrl = `https://tile.openstreetmap.org/${zoom}/${xTile}/${yTile}.png`;
---

<div class="relative w-full h-full rounded-lg overflow-hidden bg-stone-100 group">
    <!-- Static Placeholder Image (LCP Priority) -->
    <!-- This loads immediately as a high-priority resource to satisfy LCP metrics -->
    <img 
        src={staticTileUrl} 
        alt={`Map of ${name}`}
        class="absolute inset-0 w-full h-full object-cover z-0 opacity-80"
        fetchpriority="high"
        decoding="async"
    />
    
    <!-- Leaflet Container -->
    <!-- Initially invisible, fades in when JS initializes -->
    <div id="spot-map" data-lat={lat} data-lng={lng} data-name={name} class="relative z-10 w-full h-full opacity-0 transition-opacity duration-1000"></div>
</div>

<style>
  /* Ensure container has size */
  #spot-map {
    width: 100%;
    height: 100%;
    min-height: 300px;
    z-index: 10;
  }
  #spot-map.loaded {
    opacity: 1;
  }
</style>

<script>
  import L from 'leaflet';

  // Fix for default marker icons missing in production builds sometimes
  const fixLeafletIcons = () => {
    // @ts-ignore
    delete L.Icon.Default.prototype._getIconUrl;
    L.Icon.Default.mergeOptions({
      iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon-2x.png',
      iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-icon.png',
      shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png',
    });
  };

  function initMap() {
    const mapEl = document.getElementById('spot-map');
    if (!mapEl) return;
    
    // Check if map is already initialized to avoid "Map container is already initialized" error
    // @ts-ignore
    if (mapEl._leaflet_id) return;

    const lat = parseFloat(mapEl.dataset.lat || '0');
    const lng = parseFloat(mapEl.dataset.lng || '0');
    const name = mapEl.dataset.name || '';

    fixLeafletIcons();

    // Default to Taiwan center if coordinates are missing
    const validLat = lat !== 0 ? lat : 23.97565;
    const validLng = lng !== 0 ? lng : 120.9738819;
    const zoom = lat !== 0 ? 15 : 7;

    const map = L.map('spot-map', {
        zoomControl: false // Cleaner look initially
    }).setView([validLat, validLng], zoom);

    L.control.zoom({ position: 'topright' }).addTo(map);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    if (lat !== 0 && lng !== 0) {
      L.marker([validLat, validLng])
        .addTo(map)
        .bindPopup(`<div class="font-bold text-base">${name}</div><div class="text-sm">經度: ${validLng.toFixed(4)}<br>緯度: ${validLat.toFixed(4)}</div>`)
        .openPopup();
    }

    // Fade in map to reveal interactive version over static image
    mapEl.classList.add('loaded');
    
    // Cleanup static image to reduce DOM count after transition
    const staticImg = mapEl.parentElement?.querySelector('img');
    if (staticImg) {
        setTimeout(() => staticImg.remove(), 1200);
    }
  }

  // Defer initialization:
  // 1. Avoid Force Reflow by not running during critical path.
  // 2. Prioritize LCP image display (static image).
  // 3. User requestIdleCallback to run when main thread is free.
  function scheduleInit() {
      if ('requestIdleCallback' in window) {
           // @ts-ignore
           requestIdleCallback(() => initMap(), { timeout: 2000 });
      } else {
           setTimeout(initMap, 500); 
      }
  }

  // Support Astro View Transitions (ClientRouter)
  // Ensure we init on first load and subsequent navigations
  document.addEventListener('astro:page-load', scheduleInit);
</script>