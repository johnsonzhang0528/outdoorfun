---
import CampCover from './CampCover.astro';

interface Props {
	camp: {
		name: string;
		city: string;
		area: string;
		elevation: number;
		description: string;
		tags: string[];
		features: {
			has_glamping: boolean;
			high_altitude: boolean;
		};
	};
}

const { camp } = Astro.props;
---

<a href={`/camp/${camp.name}`} class="block group h-full">
	<article class="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden hover:shadow-md transition-shadow h-full flex flex-col active:scale-[0.98] transform duration-100">
		<div class="relative overflow-hidden">
			<CampCover name={camp.name} tags={camp.tags} className="h-48 w-full" />
			
			<div class="absolute top-3 right-3 flex gap-2 z-20">
				{camp.features.high_altitude && (
					<span class="bg-blue-600/90 text-white text-xs font-bold px-2 py-1 rounded backdrop-blur-sm shadow-sm">
						高海拔
					</span>
				)}
				{camp.features.has_glamping && (
					<span class="bg-amber-500/90 text-white text-xs font-bold px-2 py-1 rounded backdrop-blur-sm shadow-sm">
						豪華露營
					</span>
				)}
			</div>
		</div>
		
		<div class="p-6 flex-grow flex flex-col">
			<div class="flex justify-between items-start mb-2">
				{/* 🟢 [FIX] SEO/A11y 優化: 將 h3 改為 h2，符合 h1 -> h2 的正確層級結構 */}
				<h2 class="text-xl font-bold text-stone-900 group-hover:text-emerald-700 transition-colors">
					{camp.name}
				</h2>
				<span class="text-xs font-semibold bg-stone-100 text-stone-600 px-2 py-1 rounded-full">
					{camp.city}
				</span>
			</div>
			
			<div class="flex items-center gap-4 text-xs text-stone-500 mb-4 font-mono">
				<span>⛰️ {camp.elevation}m</span>
				<span>📍 {camp.area}</span>
			</div>

			<p class="text-stone-600 text-sm line-clamp-2 mb-4 leading-relaxed flex-grow">
				{camp.description}
			</p>
			
			<div class="flex flex-wrap gap-2 mt-auto">
				{camp.tags.slice(0, 3).map(tag => (
					<span class="text-xs text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full font-medium">
						#{tag}
					</span>
				))}
			</div>
		</div>
	</article>
</a>
