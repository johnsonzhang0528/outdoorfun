---
interface Props {
  spot?: {
    difficulty: string;
    bottom_type: string;
    tags?: string[];
  };
  // Fallback props
  tags?: string[];
  elevation?: number;
  temperature?: number;
  isRaining?: boolean;
  tag?: string; 
}

import productData from '../data/products.json';
import { isAllowedExternalUrl } from '../utils/safeHtml';

const { spot, tags, elevation, tag } = Astro.props;

// products.json is generated by py/generate_surf_products.py and is not a
// live external fetch, but it is still automated/regenerated data, so its
// link field is validated the same way as the rest of this PR's external
// data before it reaches href. Only hosts actually observed in current
// product data are allowed.
const ALLOWED_GEAR_LINK_HOSTS = ['www.momoshop.com.tw', 'www.klook.com'];

// Normalizing Spot Data (Handling diverse inputs)
const spotTags = spot?.tags || tags || [];
const difficulty = spot?.difficulty || '一般';
const bottomType = spot?.bottom_type || '';
const currentMonth = new Date().getMonth() + 1; // 1-12

// Affiliate Config
const ICHANNELS_PREFIX = ""; 

// 1. 定義衝浪情境策略 (Surfing Hooks)
const scenarios = [
  {
    id: 'winter_surf',
    // 邏輯：11月~3月，或是 tags 包含 '冷水'
    check: () => [11, 12, 1, 2, 3].includes(currentMonth) || spotTags.includes('冷水'),
    icon: '🥶',
    title: '冬季衝浪：保暖是續航關鍵',
    desc: '東北季風浪況雖好，但水溫驟降。不想衝半小時就發抖上岸，這些「禦寒裝備」一定要帶！別忘了基礎安全裝備與硬體喔！',
    targetTags: ['wetsuit', 'warmth', 'cooking', 'surf_hardware', 'safety', 'beginner'] 
  },
  {
    id: 'reef_safety',
    // 邏輯：地形包含 '礁' 或 '石'
    check: () => bottomType.includes('礁') || bottomType.includes('石'),
    icon: '🪨',
    title: '礁岩區安全對策',
    desc: '此處海底為礁岩地形，容易割傷腳底。強烈建議穿著防滑鞋 (Booties) 並攜帶急救包；此外，保護裝備越齊全越好。',
    targetTags: ['safety', 'surf_hardware', 'wetsuit', 'beginner', 'sun_protection'] 
  },
  {
    id: 'summer_beach',
    // 邏輯：5月~9月 且是 沙灘
    check: () => [5, 6, 7, 8, 9].includes(currentMonth) && bottomType.includes('沙'),
    icon: '☀️',
    title: '夏日沙灘防曬大作戰',
    desc: '夏季紫外線指數極高！除了衝浪，在岸上休息時的遮陽與補水裝備也不能少。',
    targetTags: ['sun_protection', 'beach_lifestyle', 'play', 'beginner', 'surf_hardware', 'safety']
  },
  {
    id: 'beginner_pack',
    // 邏輯：難度為 初學者
    check: () => difficulty === '初學者' || spotTags.includes('新手'),
    icon: '🐣',
    title: '新手衝浪：第一道浪裝備',
    desc: '第一次下水怕磨傷？準備好防磨衣與防水袋，讓你的衝浪初體驗更完美。安全與基礎硬體也是必備的。',
    targetTags: ['beginner', 'sun_protection', 'safety', 'wetsuit', 'surf_hardware', 'beach_lifestyle']
  },
  {
    id: 'general_surf',
    check: () => true, // Fallback
    icon: '🏄',
    title: '浪人必備：裝備檢查表',
    desc: '剛好的浪況，剛好的心情。下水前檢查一下，蠟塊、腳繩、備用舵都帶齊了嗎？',
    targetTags: ['surf_hardware', 'wetsuit', 'beach_lifestyle']
  }
];

// 2. 選擇最佳情境 (優先級：冬季 > 礁岩 > 夏季 > 新手 > 通用)
const activeScenario = scenarios.find(s => s.check()) || scenarios[scenarios.length - 1];

// 3. 智慧選品演算法
const recommendedCategories = (productData as any[])
  .filter(cat => cat.id !== 'booking-always' && (cat.tags || []).some((t: string) => activeScenario.targetTags.includes(t)))
  .map(cat => {
    const score = (cat.tags || []).filter((t: string) => activeScenario.targetTags.includes(t)).length;
    const wrappedItems = (cat.items || []).map((item: any) => ({
        ...item,
        link: ICHANNELS_PREFIX ? `${ICHANNELS_PREFIX}${encodeURIComponent(item.link)}` : item.link
    }));
    return { ...cat, items: wrappedItems, matchScore: score };
  })
  .sort((a, b) => b.matchScore - a.matchScore)
  .slice(0, 3);
---

<aside class="bg-gradient-to-br from-sky-50 to-white border border-sky-100 rounded-xl p-6 my-8 shadow-sm relative overflow-hidden">
    <div class="absolute -right-6 -top-6 text-9xl opacity-5 select-none pointer-events-none grayscale">
        {activeScenario.icon}
    </div>

    <header class="mb-6 relative z-10">
        <h3 class="text-xl md:text-2xl font-bold text-sky-900 flex items-center gap-3 mb-2">
            <span class="text-3xl shadow-sm bg-white rounded-full w-12 h-12 flex items-center justify-center border border-sky-100">{activeScenario.icon}</span>
            {activeScenario.title}
        </h3>
        <p class="text-slate-600 text-sm md:text-base pl-[60px] leading-relaxed">
            {activeScenario.desc}
        </p>
    </header>
    
    <div class="space-y-4 relative z-10">
        {recommendedCategories.length > 0 ? recommendedCategories.map((cat: any) => (
            <div class="group bg-white rounded-lg border border-slate-100 shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden">
                <div class="bg-sky-50/50 px-4 py-2 border-b border-sky-100 flex justify-between items-center">
                    <h4 class="font-bold text-slate-700 text-sm flex items-center gap-2">
                       {cat.title}
                    </h4>
                </div>
                <div class="p-3 grid gap-2">
                    {cat.items.slice(0, 3).map((item: any, idx: number) => {
                        const isValidLink = isAllowedExternalUrl(item.link, ALLOWED_GEAR_LINK_HOSTS);
                        const Wrapper = isValidLink ? 'a' : 'div';
                        const linkAttrs = isValidLink
                            ? {
                                href: item.link,
                                target: '_blank',
                                rel: 'nofollow noopener noreferrer sponsored',
                                'data-track-affiliate': 'gear',
                                'data-item-name': item.name,
                                'data-item-price': item.price,
                              }
                            : { 'aria-disabled': 'true', role: 'note' };
                        return (
                        // Wrapper's attribute shape depends on which of the two branches
                        // above ran; Astro/TS cannot express "attrs for a dynamically
                        // chosen tag" as a discriminated union, so the spread is cast here.
                        <Wrapper {...linkAttrs as any} class={`flex items-center justify-between p-2 rounded-md transition-colors group/item relative z-20 ${isValidLink ? 'hover:bg-sky-50' : 'opacity-60 cursor-not-allowed'}`}>
                            <div class="flex-1 min-w-0 pr-3">
                                <div class="flex items-start gap-2 mb-0.5">
                                    <span class={`text-xs font-bold px-1.5 py-0.5 rounded text-white shrink-0 mt-0.5 ${idx === 0 ? 'bg-blue-600' : 'bg-slate-500'}`}>
                                        {idx === 0 ? 'No.1' : (idx + 1)}
                                    </span>
                                    <span class="text-slate-700 font-medium text-sm line-clamp-2 group-hover/item:text-blue-600 transition-colors">
                                        {item.name}
                                    </span>
                                </div>
                                <p class="text-xs text-slate-400 line-clamp-1 pl-8">{item.desc}</p>
                            </div>
                            <div class="flex flex-col items-end gap-1 min-w-[80px] shrink-0">
                                <span class="text-sm font-bold text-rose-500 font-mono">{item.price}</span>
                                <span class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100 group-hover/item:bg-blue-600 group-hover/item:text-white transition-all">
                                    {item.cta || '查看'} &rarr;
                                </span>
                            </div>
                        </Wrapper>
                        );
                    })}
                </div>
            </div>
        )) : (
            <div class="text-center text-slate-400 text-sm py-4">
               目前沒有相關裝備推薦
            </div>
        )}
    </div>
    
    <div class="mt-4 text-[10px] text-slate-400 text-center">
        * 推薦商品由編輯嚴選，購買可能產生微薄分潤支持網站營運
    </div>
</aside>