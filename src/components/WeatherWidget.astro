---
// src/components/WeatherWidget.astro

interface ForecastDay {
  date: string;
  max_temp: number;
  min_temp: number;
  rain_prob: number;
  weather_code: number;
  label: string;
  icon: string;
}

interface MarineData {
  hourly: {
    time: string[];
    wave_height: number[];
    wave_period: number[];
    swell_wave_height: number[];
    swell_wave_period: number[];
    swell_wave_direction: number[];
  };
}

interface Props {
  forecast?: ForecastDay[]; // Legacy (Camping)
  marineData?: MarineData;  // New (Surf)
  spotName?: string;
  city?: string;
  updatedAt?: string;
}

const { forecast, marineData, spotName, city, updatedAt } = Astro.props;

// determine mode
const isSurfMode = !!marineData;

// Surf Logic
let currentWave = 0;
let currentSwell = 0;
let currentPeriod = 0;
let chartData = [];

if (isSurfMode && marineData?.hourly) {
    const now = new Date();
    // Simple closest hour (Open-Meteo returns ISO strings)
    // Find index where time > now - 1 hour
    const nowTime = now.getTime();
    const times = marineData.hourly.time.map(t => new Date(t).getTime());
    let index = times.findIndex(t => t >= nowTime);
    if (index === -1) index = 0; // Fallback or end of list

    currentWave = marineData.hourly.wave_height[index] || 0;
    currentSwell = marineData.hourly.swell_wave_height[index] || 0;
    currentPeriod = marineData.hourly.swell_wave_period[index] || 0;

    // Prepare Chart Data (Next 24 Hours)
    // Simple bar chart normalized to max height
    const hoursToShow = 24;
    const sliceStart = index;
    const sliceEnd = index + hoursToShow;
    
    // Ensure we don't go out of bounds
    const safeSliceEnd = Math.min(sliceEnd, marineData.hourly.time.length);

    const sliceTimes = marineData.hourly.time.slice(sliceStart, safeSliceEnd);
    const sliceWaves = marineData.hourly.wave_height.slice(sliceStart, safeSliceEnd);
    
    const maxWave = Math.max(...sliceWaves, 0.5); // Min 0.5m for scale
    
    chartData = sliceWaves.map((h, i) => ({
        height: h,
        barHeight: (h / maxWave) * 100, // Percentage
        time: new Date(sliceTimes[i]).getHours(),
        isDay: new Date(sliceTimes[i]).getHours() >= 6 && new Date(sliceTimes[i]).getHours() <= 18
    }));
}

// Camping Logic Helpers (Legacy)
function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  const today = new Date();
  if (date.toDateString() === today.toDateString()) return "今天";
  return `${date.getMonth() + 1}/${date.getDate()}`;
}
const ICONS: Record<string, string> = {
  "clear-day": "☀️", "partly-cloudy-day": "⛅", "cloudy": "☁️", "overcast": "☁️",
  "fog": "🌫️", "drizzle": "🌦️", "rain": "🌧️", "sleet": "🌨️", "snow": "❄️", "thunderstorm": "⛈️"
};
---

<div class="bg-white rounded-2xl shadow-sm border border-stone-100 p-6">
  <div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-xl font-bold text-stone-800 flex items-center gap-2">
            {isSurfMode ? '🌊 即時浪況預報' : '🌦️ 一週天氣預報'}
        </h2>
        {isSurfMode && spotName && (
            <p class="text-xs text-stone-500 mt-1">地點: {spotName} (Open-Meteo Marine)</p>
        )}
    </div>
  </div>

  {isSurfMode ? (
    <div class="space-y-6">
        {/* Current Stats */}
        <div class="grid grid-cols-3 gap-4">
            <div class="text-center p-3 bg-blue-50 rounded-xl border border-blue-100">
                <span class="block text-2xl font-black text-blue-700">{currentWave}<span class="text-sm">m</span></span>
                <span class="text-xs text-blue-800 font-bold">浪高</span>
            </div>
            <div class="text-center p-3 bg-teal-50 rounded-xl border border-teal-100">
                <span class="block text-2xl font-black text-teal-700">{currentPeriod}<span class="text-sm">s</span></span>
                <span class="text-xs text-teal-800 font-bold">週期</span>
            </div>
            <div class="text-center p-3 bg-indigo-50 rounded-xl border border-indigo-100">
                <span class="block text-2xl font-black text-indigo-700">{currentSwell}<span class="text-sm">m</span></span>
                <span class="text-xs text-indigo-800 font-bold">湧浪</span>
            </div>
        </div>

        {/* 24H Trend Chart */}
        <div>
            <h3 class="text-sm font-bold text-stone-600 mb-3 ml-1">未來 24 小時浪高趨勢</h3>
            <div class="h-32 flex items-end gap-[2%] pt-6 pb-2 px-1 relative">
                {/* Grid Lines */}
                <div class="absolute inset-x-0 bottom-0 h-px bg-stone-200"></div>
                <div class="absolute inset-x-0 top-0 h-px bg-stone-100 border-t border-dashed border-stone-200"></div>
                
                {chartData.map((d) => (
                    <div class="flex-1 flex flex-col items-center group relative group h-full justify-end">
                        <div 
                            style={`height: ${d.barHeight}%`} 
                            class={`w-full rounded-t-sm transition-all duration-300 ${d.isDay ? 'bg-blue-400' : 'bg-indigo-300'} group-hover:bg-blue-600`}
                        ></div>
                        {d.time % 3 === 0 && (
                            <span class="absolute -bottom-5 text-[10px] text-stone-400 font-mono">
                                {d.time}
                            </span>
                        )}
                        {/* Tooltip */}
                        <div class="hidden group-hover:block absolute bottom-full mb-1 left-1/2 -translate-x-1/2 bg-stone-800 text-white text-[10px] py-1 px-2 rounded pointer-events-none whitespace-nowrap z-10">
                            {d.height}m / {d.time}:00
                        </div>
                    </div>
                ))}
            </div>
        </div>
        
        <div class="p-3 bg-amber-50 border border-amber-100 rounded-lg text-xs text-amber-800 flex items-start gap-2 mt-4">
            <span class="text-base">💡</span>
            <span>浪況變化快速，新手建議在無風且浪高 1m 以下時下水。若遇紅旗請勿強行下水。</span>
        </div>
    </div>
  ) : (
    /* Existing Camping Weather (Legacy) */
    <div class="space-y-4">
        {forecast && forecast.length > 0 ? (
            <div class="flex gap-4 overflow-x-auto pb-4 snap-x">
                {forecast.map((day, idx) => (
                    <div class="snap-start shrink-0 w-24 flex flex-col items-center p-3 rounded-xl border border-stone-100 bg-stone-50">
                        <span class="text-xs text-stone-500 font-medium mb-1">{formatDate(day.date)}</span>
                        <span class="text-2xl mb-1">{ICONS[day.icon] || "⛅"}</span>
                        <div class="flex items-end gap-1 mb-1">
                            <span class="text-stone-800 font-bold">{day.max_temp}°</span>
                            <span class="text-stone-400 text-xs">{day.min_temp}°</span>
                        </div>
                        {day.rain_prob > 0 && (
                            <span class="text-[10px] text-blue-500 font-bold">☂ {day.rain_prob}%</span>
                        )}
                    </div>
                ))}
            </div>
        ) : (
            <div class="p-8 text-center text-stone-400 bg-stone-50 rounded-xl border border-dashed border-stone-200">
                暫無天氣資料
            </div>
        )}
    </div>
  )}
</div>
