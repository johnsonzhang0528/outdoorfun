---
// src/components/NativeAdCard.astro

// 1. 定義廣告資料庫 (Ad Pool)
// 您可以隨時在這裡擴充更多廣告變體
const ads = [
  {
    id: 'gear-upgrade',
    badges: [
      { text: '⚡ 限時優惠', color: 'amber' },
      { text: '裝備升級', color: 'emerald' }
    ],
    title: '還在煩惱缺什麼裝備嗎？',
    desc: '工欲善其事，必先利其器。看看資深露友們都在用什麼好物，讓露營體驗更舒適。',
    image: '/gear.webp',
    cta: '前往 momo 購物網逛逛',
    link: 'https://www.momoshop.com.tw/category/LgrpCategory.jsp?l_code=1699900000'
  },
  {
    id: 'glamping-trip',
    badges: [
      { text: '✨ 豪華體驗', color: 'purple' },
      { text: '免裝備', color: 'pink' }
    ],
    title: '想露營又不想搭帳棚？',
    desc: '精選全台豪華露營 Glamping！冷氣、獨立衛浴、星空電影院，輕鬆享受大自然。',
    image: '/glamping.webp',
    cta: '查看 Klook 優惠行程',
    link: 'https://www.klook.com/zh-TW/search/result/?query=%E8%B1%AA%E8%8F%AF%E9%9C%B2%E7%87%9F'
  },
  {
    id: 'camp-food',
    badges: [
      { text: '🔥 野炊美食', color: 'orange' },
      { text: '大廚上菜', color: 'red' }
    ],
    title: '露營吃什麼？美味輕鬆煮',
    desc: '戶外料理神隊友！從鑄鐵鍋到方便調理包，無需繁瑣準備，野外也能端出五星級料理。',
    image: '/food.webp',
    cta: '逛逛 momo 露營食材',
    link: 'https://www.momoshop.com.tw/search/searchShop.jsp?keyword=%E9%9C%B2%E7%87%9F%E9%A3%9F%E6%9D%90'
  },
  {
    id: 'summer-cool',
    badges: [
      { text: '❄️ 涼感推薦', color: 'blue' },
      { text: '消暑必備', color: 'cyan' }
    ],
    title: '拒絕悶熱！夏日露營攻略',
    desc: '移動式冷氣、大風量循環扇、保冰桶。帶對裝備，夏天露營也能涼爽舒適。',
    image: '/summer.webp',
    cta: '前往 momo 抗熱專區',
    link: 'https://www.momoshop.com.tw/search/searchShop.jsp?keyword=%E9%9C%B2%E7%87%9F%E9%A2%A8%E6%89%87'
  }
];

// Helper function to map color names to Tailwind classes
function getBadgeClasses(color: string) {
    // 這裡列舉出所有可能用到的顏色，確保 Tailwind 編譯時不會遺漏
    const colors: Record<string, string> = {
        amber: 'text-amber-600 bg-amber-50 border-amber-100',
        emerald: 'text-emerald-600 bg-emerald-50 border-emerald-100',
        purple: 'text-purple-600 bg-purple-50 border-purple-100',
        pink: 'text-pink-600 bg-pink-50 border-pink-100',
        orange: 'text-orange-600 bg-orange-50 border-orange-100',
        red: 'text-red-600 bg-red-50 border-red-100',
        blue: 'text-blue-600 bg-blue-50 border-blue-100',
        cyan: 'text-cyan-600 bg-cyan-50 border-cyan-100',
    };
    return colors[color] || colors['emerald'];
}

// 預先處理廣告資料，把 Badge 的 Class 算好，方便前端 JS 直接使用
const adsWithClasses = ads.map(ad => ({
    ...ad,
    badges: ad.badges.map(b => ({
        ...b,
        classString: `text-[10px] font-bold px-2 py-0.5 rounded-full border ${getBadgeClasses(b.color)}`
    }))
}));

// Server-side random selection (for SEO/Static pages)
const selectedAd = ads[Math.floor(Math.random() * ads.length)];
---

<article 
  class="bg-white rounded-2xl shadow-sm border border-stone-100 h-full flex flex-col relative group hover:shadow-lg hover:border-emerald-200 transition-all duration-300 overflow-hidden js-native-ad"
  data-ads-pool={JSON.stringify(adsWithClasses)}
>
  
  <div class="absolute top-3 right-3 z-10">
    <span class="bg-stone-900/80 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-1 rounded border border-white/20 tracking-wider">
      SPONSORED
    </span>
  </div>
  
  <div class="h-48 relative overflow-hidden bg-stone-200">
     <img 
        src={selectedAd.image} 
        alt={selectedAd.title} 
        width="800"
        height="450"
        loading="lazy" 
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 js-ad-img"
     />
     <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
  </div>

  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
        <div class="flex gap-2 mb-3 js-ad-badges">
             {selectedAd.badges.map(badge => (
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full border ${getBadgeClasses(badge.color)}`}>
                    {badge.text}
                </span>
             ))}
        </div>

        <h3 class="font-bold text-xl text-stone-800 mb-2 group-hover:text-emerald-700 transition-colors js-ad-title">
            {selectedAd.title}
        </h3>
        <p class="text-stone-600 text-sm line-clamp-2 mb-4 leading-relaxed js-ad-desc">
            {selectedAd.desc}
        </p>
    </div>
    
    <div class="mt-auto">
        <span class="w-full block text-center bg-stone-100 group-hover:bg-emerald-600 group-hover:text-white text-stone-600 text-sm font-bold py-2.5 rounded-lg transition-colors duration-300 js-ad-cta">
            {selectedAd.cta}
        </span>
    </div>
  </div>

  <a href={selectedAd.link} target="_blank" rel="nofollow sponsored" class="absolute inset-0 z-0 js-ad-link" aria-label={selectedAd.title}></a>
</article>
