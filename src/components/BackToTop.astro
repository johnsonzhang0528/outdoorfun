---
// src/components/BackToTop.astro
---
<button
    id="back-to-top"
    aria-label="回到頂端"
    class="fixed bottom-24 right-6 md:bottom-8 z-40 bg-stone-900/80 hover:bg-emerald-600 text-white p-3 rounded-full shadow-lg backdrop-blur-sm transition-all duration-300 opacity-0 invisible translate-y-4 active:scale-90"
>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
</button>

<script>
    let scrollHandler;

    // 監聽 astro:page-load 事件，確保在 View Transitions 切換頁面後也能運作
    document.addEventListener('astro:page-load', () => {
        const backToTopBtn = document.getElementById('back-to-top');

        if (backToTopBtn) {
            // 防止重複綁定：如果在同一個 session 中，先移除舊的監聽器
            if (scrollHandler) {
                window.removeEventListener('scroll', scrollHandler);
            }

            // 1. 顯示/隱藏邏輯
            scrollHandler = () => {
                if (window.scrollY > 300) {
                    backToTopBtn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
                    backToTopBtn.classList.add('opacity-100', 'visible', 'translate-y-0');
                } else {
                    backToTopBtn.classList.add('opacity-0', 'invisible', 'translate-y-4');
                    backToTopBtn.classList.remove('opacity-100', 'visible', 'translate-y-0');
                }
            };

            // 2. 點擊回頂端邏輯
            const scrollToTop = () => {
                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            };

            // 3. 綁定事件
            window.addEventListener('scroll', scrollHandler);
            backToTopBtn.addEventListener('click', scrollToTop);
            
            // 初始化檢查 (避免換頁時已在底部但按鈕沒出現)
            scrollHandler();
        }
    });
</script>
