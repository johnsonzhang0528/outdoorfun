---
import Layout from '../../layouts/Layout.astro';
import SpotCard from '../../components/SpotCard.astro';
import NativeAdCard from '../../components/NativeAdCard.astro';
import GearChecklist from '../../components/GearChecklist.astro';
import spots from '../../data/surf_spots.json';
import { TOPIC_CONFIG } from '../../data/topic_expansion';

// 定義 Spot 型別，避免 TypeScript 報錯
type Spot = {
    name: string;
    city: string;
    area: string;
    tags?: string[];
    features?: string[];
    difficulty?: string;
    bottom_type?: string;
    best_swell?: string;
    best_wind?: string;
    description?: string;
};

export async function getStaticPaths() {
  const paths = [];
  const safeSpots = spots as Spot[];

  // 1. 生成 [城市 + 特徵] 組合頁面 (e.g., /topic/yilan-beginner)
  const { targetCities, features } = TOPIC_CONFIG;

  targetCities.forEach(cityObj => {
    Object.entries(features).forEach(([featureSlug, featureConfig]) => {
      // 篩選出符合條件的浪點
      const matchedSpots = safeSpots.filter(spot => {
        const isCityMatch = spot.city === cityObj.name;
        // 檢查 Tags 或 Features 或 Difficulty 是否包含特徵關鍵字 (OR logic)
        const isFeatureMatch = featureConfig.tags.some(tag => 
          spot.tags?.includes(tag) || 
          spot.features?.includes(tag) || 
          spot.difficulty === tag ||
          spot.bottom_type === tag
        );
        return isCityMatch && isFeatureMatch;
      });

      // 只有當該主題有至少 1 個浪點時，才生成頁面 (避免 Empty Pages)
      if (matchedSpots.length > 0) {
        paths.push({
          params: { id: `${cityObj.slug}-${featureSlug}` },
          props: {
            type: 'city-feature',
            title: `${cityObj.name}${featureConfig.name}推薦`,
            description: `正在尋找${cityObj.name}的${featureConfig.name}嗎？我們為您精選 ${matchedSpots.length} 個最適合的浪點與衝浪資訊。`,
            spots: matchedSpots,
            city: cityObj.name,
            keyword: featureConfig.name
          }
        });
      }
    });
  });

  // 2. 生成 [通用主題] 頁面 (e.g., /topic/all-beginner)
  TOPIC_CONFIG.generalTopics.forEach(topic => {
      let matchedSpots = [];
      
      // 根據 ID 硬編碼的特定篩選邏輯
      if (topic.id === 'all-beginner') {
          matchedSpots = safeSpots.filter(s => s.difficulty === '初學者' || s.tags?.includes('新手') || s.tags?.includes('教學'));
      } else if (topic.id === 'best-winter') {
          matchedSpots = safeSpots.filter(s => s.best_swell?.includes('東北') || s.tags?.includes('東北季風'));
      } else if (topic.id === 'summer-vibes') {
          matchedSpots = safeSpots.filter(s => s.best_swell?.includes('西南') || s.best_wind?.includes('西南'));
      } else {
        // Fallback catch all if logic not defined above
        matchedSpots = []; 
      }

      if (matchedSpots.length > 0) {
          paths.push({
            params: { id: topic.id },
            props: {
                type: 'general',
                title: topic.title,
                description: topic.desc,
                spots: matchedSpots,
                city: null, // 通用主題不限城市，所以 AdCard 隨機顯示
                keyword: topic.title
            }
          });
      }
  });

  return paths;
}

const { title, description, spots: pageSpots, city, keyword } = Astro.props;
const { id } = Astro.params;

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
            "@type": "ListItem",
            "position": 1,
            "name": "首頁",
            "item": Astro.site ? Astro.site.origin : "https://surftaiwan.url" // Fallback if Astro.site is not set
            },
            {
            "@type": "ListItem",
            "position": 2,
            "name": "主題策展",
            "item": Astro.site ? `${Astro.site.origin}/topic` : "https://surftaiwan.url/topic"
            },
            {
            "@type": "ListItem",
            "position": 3,
            "name": title,
            "item": Astro.url.href
            }
        ]
    },
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": Astro.url.href
    },
    {
      "@type": "ItemList",
      "name": `${title}列表`,
      "itemListElement": pageSpots.map((spot, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `${Astro.site ? Astro.site.origin : ''}/spot/${spot.name}`,
        "name": spot.name
      }))
    }
  ]
};
---

<Layout title={`${title} | Surf Taiwan 衝浪地圖`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  
  {/* Hero Header */}
  <div class="bg-gradient-to-b from-slate-900 to-slate-800 text-white pt-32 pb-16 px-4">
    <div class="container mx-auto max-w-6xl">
        <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6">
            <div>
                <nav class="flex items-center text-sm text-slate-400 mb-4 space-x-2">
                    <a href="/" class="hover:text-sky-400 transition-colors">首頁</a>
                    <span>/</span>
                    <span class="text-white">主題策展</span>
                </nav>
                <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-4">
                    {title}
                </h1>
                <p class="text-lg text-slate-300 max-w-2xl leading-relaxed">
                    {description}
                </p>
            </div>
            
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 rounded-xl p-4 min-w-[150px] text-center">
                <div class="text-3xl font-bold text-sky-400">{pageSpots.length}</div>
                <div class="text-xs text-slate-400 uppercase tracking-widest mt-1">收錄浪點</div>
            </div>
        </div>
    </div>
  </div>

  {/* Main Content Area */}
  <div class="bg-stone-50 min-h-screen py-12 px-4">
    <div class="container mx-auto max-w-6xl">
        
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            
            {/* Left Column: Spots Grid (Occupies 3 cols) */}
            <div class="lg:col-span-3">
                
                {/* 簡單的篩選標籤顯示 */}
                <div class="flex flex-wrap gap-2 mb-8">
                    <span class="px-3 py-1 bg-sky-100 text-sky-800 rounded-full text-sm font-bold">
                        #{keyword}
                    </span>
                    {city && (
                        <span class="px-3 py-1 bg-stone-200 text-stone-700 rounded-full text-sm">
                            #{city}
                        </span>
                    )}
                    <span class="px-3 py-1 bg-stone-200 text-stone-700 rounded-full text-sm">
                        共 {pageSpots.length} 個結果
                    </span>
                </div>

                {/* Spots Listing */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {pageSpots.map((spot, index) => (
                        <>
                            {/* 1. 渲染浪點卡片 */}
                            <SpotCard spot={spot} />

                            {/* 2. 🟢 [Feature 1] 手機版導購插入 (Mobile In-Feed Injection) */}
                            {/* 邏輯：在第 2 個浪點 (index 1) 之後，強制插入「裝備檢查表」 */}
                            {index === 1 && (
                                <div class="md:hidden col-span-1 my-4">
                                    {/* 這裡我們隨機挑選一些 tags 傳入，或者根據 topic 類型傳入 */}
                                    <div class="bg-stone-50 border-y border-stone-200 -mx-4 px-4 py-6">
                                        <h3 class="font-bold text-stone-800 mb-4 flex items-center gap-2">
                                            <span>🎒</span> 上山下海裝備檢查
                                        </h3>
                                        {/* 傳入一個虛擬的 spot 物件讓 Checklist 運作，或是修改 Checklist 接受 tags */}
                                        <GearChecklist spot={{ 
                                            difficulty: '初學者', 
                                            bottom_type: '沙灘', 
                                            tags: ['新手', '防曬'] 
                                        }} />
                                        <p class="text-xs text-center text-stone-400 mt-2">
                                            工欲善其事，必先利其器
                                        </p>
                                    </div>
                                </div>
                            )}

                            {/* 3. 🟢 [Feature 2] 週期性廣告循環 (Cyclic Ad Injection) */}
                            {/* 邏輯：每隔 6 個浪點插入一張廣告 (index 5, 11, 17...) */}
                            {(index + 1) % 6 === 0 && (
                                <div class="col-span-1 md:col-span-2 py-4">
                                    <NativeAdCard />
                                </div>
                            )}
                        </>
                    ))}
                </div>

                {/* Empty State Fallback (Should be rare due to getStaticPaths filtering) */}
                {pageSpots.length === 0 && (
                    <div class="text-center py-20 bg-white rounded-2xl border border-stone-100 shadow-sm">
                        <p class="text-stone-500 text-lg">目前沒有符合條件的浪點資料。</p>
                        <a href="/" class="inline-block mt-4 text-sky-600 font-bold hover:underline">
                            回首頁瀏覽更多
                        </a>
                    </div>
                )}
            </div>

            {/* Right Column: Sidebar (Occupies 1 col) */}
            <div class="lg:col-span-1 space-y-8">
                
                {/* 1. Contextual Ad (Data-Driven Smart Fallback) */}
                <div class="sticky top-24">
                   <NativeAdCard city={city || undefined} />
                </div>

            </div>

        </div>
    </div>
  </div>

</Layout>
