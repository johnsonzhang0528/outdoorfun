---
import Layout from '../../layouts/Layout.astro';
import SpotCard from '../../components/SpotCard.astro';
import NativeAdCard from '../../components/NativeAdCard.astro';
import GearChecklist from '../../components/GearChecklist.astro';
import SpotCompareTable from '../../components/SpotCompareTable.astro';
import SurfLessonCTA from '../../components/SurfLessonCTA.astro';
import spots from '../../data/surf_spots.json';
import marineData from '../../data/sea_conditions.json';
import { TOPIC_CONFIG } from '../../data/topic_expansion';
import { getValidSpots } from '../../utils/filterSpots';
import { getAdRotator } from '../../utils/adManager';
import { summarizeRegionSea, seaUpdatedAt, todayWaveRange, getSpotStats } from '../../utils/surfData';
import { toSafeJsonScript } from '../../utils/safeHtml';
import { SITE_ORIGIN_FALLBACK } from '../../utils/urls';

// 定義 Spot 型別，避免 TypeScript 報錯
type Spot = {
    name: string;
    city: string;
    area: string;
    tags?: string[];
    features?: string[];
    difficulty?: string;
    bottom_type?: string;
    best_swell?: string;
    best_wind?: string;
    description?: string;
    lat: number;
    lng: number;
};

export async function getStaticPaths() {
  const paths = [];
  const validSpots = getValidSpots(spots);
  const safeSpots = validSpots as Spot[];

  // SEO consolidation batch 1: these 5 city-feature topic pages had 0 GSC
  // clicks/impressions over 16 months, 0 Ahrefs backlinks, and no internal
  // inbound links anywhere in the site. Each has a 301 to a more relevant
  // existing page in vercel.json. Retired by exact slug, not by spot count,
  // so no other topic page is affected.
  const RETIRED_TOPIC_SLUGS = new Set([
    'hualien-reef-break',
    'yilan-reef-break',
    'kaohsiung-reef-break',
    'taichung-easy-access',
    'taichung-sandy-beach',
  ]);

  // 1. 生成 [城市 + 特徵] 組合頁面 (e.g., /topic/yilan-beginner)
  const { targetCities, features } = TOPIC_CONFIG;

  targetCities.forEach(cityObj => {
    Object.entries(features).forEach(([featureSlug, featureConfig]) => {
      const topicSlug = `${cityObj.slug}-${featureSlug}`;
      if (RETIRED_TOPIC_SLUGS.has(topicSlug)) return;

      // 篩選出符合條件的浪點
      const matchedSpots = safeSpots.filter(spot => {
        const isCityMatch = spot.city === cityObj.name;
        // 檢查 Tags 或 Features 或 Difficulty 是否包含特徵關鍵字 (OR logic)
        const isFeatureMatch = featureConfig.tags.some(tag => 
          spot.tags?.includes(tag) || 
          spot.features?.includes(tag) || 
          spot.difficulty === tag ||
          spot.bottom_type === tag
        );
        return isCityMatch && isFeatureMatch;
      });

      // 只有當該主題有至少 1 個浪點時，才生成頁面 (避免 Empty Pages)
      if (matchedSpots.length > 0) {
        paths.push({
          params: { id: `${cityObj.slug}-${featureSlug}` },
          props: {
            type: 'city-feature',
            title: `${cityObj.name}${featureConfig.name}推薦`,
            description: `正在尋找${cityObj.name}的${featureConfig.name}嗎？我們為您精選 ${matchedSpots.length} 個最適合的浪點與衝浪資訊。`,
            spots: matchedSpots,
            city: cityObj.name,
            keyword: featureConfig.name
          }
        });
      }
    });
  });

  // 2. 生成 [通用主題] 頁面 (e.g., /topic/all-beginner)
  const currentYear = new Date().getFullYear(); // 🟢 pSEO 關鍵：注入當前年份

  TOPIC_CONFIG.generalTopics.forEach(topic => {
      let matchedSpots = [];
      let dynamicTitle = topic.title;
      let dynamicDesc = topic.desc;

      // 根據 ID 硬編碼的特定篩選邏輯
      if (topic.id === 'all-beginner') {
          matchedSpots = safeSpots.filter(s => s.difficulty === '初學者' || s.tags?.includes('新手') || s.tags?.includes('教學'));
      } else if (topic.id === 'all-advanced') {
          matchedSpots = safeSpots.filter(s => s.difficulty === '中級' || s.difficulty === '專家' || s.tags?.includes('進階') || s.tags?.includes('高手'));
      } else if (topic.id === 'best-winter') {
           // 🟢 季節性 pSEO 邏輯升級：檢查最佳浪向是否包含「東北」或「北」
          // Checks best_swell keywords defined in configuration
          const mapping = TOPIC_CONFIG.seasonMapping.winter;
          matchedSpots = safeSpots.filter(s => 
            mapping.keywords.some(k => s.best_swell?.includes(k)) || 
            s.tags?.includes('東北季風') ||
            s.tags?.includes('冬季浪點')
          );
          // 優化：動態標題與描述
          dynamicTitle = `${currentYear} 全台${mapping.adjective}衝浪地圖`;
          dynamicDesc = `東北季風來襲！為您整理全台灣 ${matchedSpots.length} 個最適合冬季衝浪的浪點。這些地點在東北浪況下表現最佳，是${currentYear}年冬天的首選。`;
      } else if (topic.id === 'summer-vibes') {
          const mapping = TOPIC_CONFIG.seasonMapping.summer;
          matchedSpots = safeSpots.filter(s => 
            mapping.keywords.some(k => s.best_swell?.includes(k)) || 
            s.best_wind?.includes('西南') ||
            s.tags?.includes('夏季浪點')
          );
          
          dynamicTitle = `${currentYear} 夏日${mapping.adjective}衝浪特輯`;
          dynamicDesc = `夏天除了颱風浪還能去哪？精選 ${matchedSpots.length} 個適合西南氣流的浪點，讓你在炎炎夏日也能享受衝浪樂趣。`;
      } else {
        // Fallback catch all if logic not defined above
        matchedSpots = []; 
      }

      if (matchedSpots.length > 0) {
          paths.push({
            params: { id: topic.id },
            props: {
                type: 'general',
                title: dynamicTitle,
                description: dynamicDesc,
                spots: matchedSpots,
                city: null, // 通用主題不限城市，所以 AdCard 隨機顯示
                keyword: topic.title
            }
          });
      }
  });

  return paths;
}

const { title, spots: pageSpots, city, keyword } = Astro.props;
let { description } = Astro.props;
const { id } = Astro.params;
const adRotator = getAdRotator();

// 🟢 [Slug-specific enhancement] 僅覆寫 taichung-surf-school 的 description，
// 讓 title/H1/meta/hero/schema 從「浪點推薦」語氣統一改為「怎麼選課程/教練」的
// commercial intent 語氣，不影響其他 45 個 topic 頁（description prop 仍由
// getStaticPaths() 產生，這裡只在單一 slug 下覆寫該變數）。
if (id === 'taichung-surf-school') {
    description = `第一次到台中學衝浪？這裡整理怎麼選衝浪課程與教練、課程通常包含哪些項目，以及台中 ${pageSpots.length} 個浪點的實際環境，幫你上課前先做好功課。`;
}

// 🟢 [Data-Driven] 真實海況 + 統計 + 今日各浪點浪高
const marine = marineData as Record<string, any>;
const regionSea = summarizeRegionSea(marine, pageSpots, city || '全台');
const seaUpdated = seaUpdatedAt(marine);
const topicStats = getSpotStats(pageSpots);
const topicWaves: Record<string, { min: number; max: number } | null> = {};
for (const s of pageSpots) topicWaves[s.name] = todayWaveRange(marine[s.name]);

// 🟢 [變現] 新手類主題 → 顯示衝浪課程 CTA(高意圖轉換)
const isBeginnerTopic = id === 'all-beginner'
  || /新手|初學|beginner/i.test(id)
  || /新手|初學|教學/.test(String(keyword || ''));
const beginnerSpotNames = pageSpots.filter((s: any) => s.difficulty === '初學者').map((s: any) => s.name);

// 🟢 [SEO] FAQ Logic
const faqItems = [];
if (pageSpots.length > 0) {
    faqItems.push({
        question: `${title}包含哪些推薦浪點？`,
        answer: `本專題精選了 ${pageSpots.slice(0, 5).map(s => `<a href="/spot/${s.name}/">${s.name}</a>`).join('、')} 等 ${pageSpots.length} 個與「${keyword}」相關的熱門衝浪地點。`
    });

    faqItems.push({
        question: `這些浪點有什麼特色？`,
        answer: `這些地點主要符合「${keyword}」的篩選條件。${description}`
    });
}

// 🟢 [Slug-specific enhancement] 僅供 /topic/taichung-surf-school/ 使用，
// 不影響其他 46 個 topic 頁的渲染邏輯或輸出。
// 目的：把原本「城市+特徵」通用模板頁，針對「台中衝浪教學/課程/教練」這種
// commercial/transactional 查詢意圖，補上真正有 Information Gain 的內容，
// 而非單純重複浪點清單（city page 已經有）。
const isTaichungSurfSchool = id === 'taichung-surf-school';
// 🟡 [Seasonality accuracy] 資料集裡每個浪點只有單一 best_swell 欄位（如「南」「南風」），
// 沒有獨立的月份/季節資料來源。因此這裡只陳述「swell 方向偏好」這個資料集直接支持的事實，
// 不推論成「最佳月份」或「哪一季浪況比較穩定」——那需要跨月的浪高/頻率資料才能佐證，
// 目前資料集沒有提供，所以刻意不使用 getCitySeasonProfile() 的月份/季節文案。
const taichungSwellNote = isTaichungSurfSchool
    ? (pageSpots.every((s: Spot) => (s.best_swell || '').includes('南'))
        ? '南向 swell（南、南風）'
        : '不同浪點的最佳 swell 方向不完全一致')
    : null;

if (isTaichungSurfSchool) {
    faqItems.push({
        question: `台中適合學衝浪嗎？`,
        answer: `台中目前收錄的浪點都在沙岸地形、浪況平緩，屬於初學者友善的入門環境，且現場都有衝浪店與租板服務，方便新手第一次下水前準備裝備（實際是否提供教學課程請以店家現場資訊為準）。但台中的浪點選擇不多（目前僅 ${pageSpots.length} 個），浪型也偏單一，不算是「進階挑戰」或「浪點多樣性」取向的地區。`
    });
    faqItems.push({
        question: `台中學衝浪適合哪些人？`,
        answer: `最適合的是完全新手、想安全體驗一次衝浪、或住在台中／中部想就近上課的人。已有基礎、想挑戰不同浪型或礁石地形的進階衝浪者，通常會往浪點選擇更多的地區移動。`
    });
    faqItems.push({
        question: `第一次上課該怎麼選教練或衝浪店？`,
        answer: `建議優先確認：教練是否會先教基本安全與觀浪知識，而不是直接推下水；裝備（板子、防寒衣、腳繩）是否包含在課程內；上課地點是否就是實際下水的浪點，離停車、盥洗等生活機能近不近。可以先參考<a href="/city/台中市/">台中市浪點總覽</a>確認現場環境，再決定要不要報名課程。`
    });
    faqItems.push({
        question: `衝浪課程費用怎麼看，裝備需要自備嗎？`,
        answer: `預約前建議先確認費用是否包含教練指導、衝浪板、防磨衣或防寒衣、保險與交通接送；不同方案的包含項目可能不同，價格也會依課程長度與是否一對一而異，實際內容與費用請以報名頁面公告為準，本站不代為保證特定價格或內容。`
    });
    faqItems.push({
        question: `台中浪況要注意什麼？`,
        answer: `台中目前收錄的浪點記錄的最佳 swell 方向多為${taichungSwellNote}，但實際浪況會依當天浪向、風向與浪高而不同，並非固定不變。建議上課前留意當日海況，浪況不穩定時不建議勉強下水，尤其是第一次上課的新手。`
    });
    faqItems.push({
        question: `台中浪點選擇不多，有其他附近地區可以考慮嗎？`,
        answer: `如果想要更多元的浪型或浪點選擇，台中北邊的<a href="/city/苗栗縣/">苗栗縣</a>浪點數量明顯較多，是地理上最順路的延伸選項；也可以直接參考<a href="/guide/beginner/">全台新手友善衝浪浪點清單</a>比較其他地區。`
    });
}

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@graph": [
    // ... existing ...
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
            "@type": "ListItem",
            "position": 1,
            "name": "首頁",
            "item": Astro.site ? Astro.site.origin : SITE_ORIGIN_FALLBACK
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": title,
            "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": Astro.url.href
    },
    {
      "@type": "ItemList",
      "name": `${title}列表`,
      "itemListElement": pageSpots.map((spot, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `${Astro.site ? Astro.site.origin : ''}/spot/${spot.name}/`, // 🟢 [Fix] 補上結尾斜線，避免 Schema 連結到非標準網址
        "name": spot.name
      }))
    },
    ...(faqItems.length > 0 ? [{
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
            "@type": "Question",
            "name": item.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": item.answer
            }
        }))
    }] : [])
  ]
};
---

<Layout title={`${title} | Surf Taiwan 衝浪地圖`} description={description} geo={{ placename: city || '台灣' }}>
  <script type="application/ld+json" set:html={toSafeJsonScript(breadcrumbSchema)} />
  
  {/* Hero Header */}
  <div class="bg-slate-900 text-white py-16 md:py-24 relative overflow-hidden">
    {/* 背景紋理 */}
    <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>

    <div class="container mx-auto px-4 relative z-10 text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6 tracking-tight">
            {title}
        </h1>
        <p class="max-w-2xl mx-auto text-slate-300 text-lg md:text-xl leading-relaxed font-light">
            {description}
        </p>
    </div>
  </div>

  {/* Main Content Area */}
  <div class="bg-stone-50 min-h-screen py-12 px-4">
    <div class="container mx-auto">
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
            
            {/* Main Content: Spots Grid */}
            <div class="lg:col-span-2">
                <div class="flex justify-between items-center mb-6 border-b border-stone-200 pb-4">
                    <span class="text-stone-500 text-sm">共找到 <strong class="text-stone-800">{pageSpots.length}</strong> 個浪點</span>
                    <div class="text-sm text-stone-500">
                        排序：<span class="font-medium text-sky-700">熱門程度</span>
                    </div>
                </div>

                {/* 🟢 [Data-Driven] 今日真實區域海況 */}
                {regionSea && (
                    <div class="mb-6 flex items-start gap-3 bg-sky-50 border border-sky-100 rounded-xl px-5 py-4">
                        <span class="text-2xl leading-none">🌊</span>
                        <div>
                            <p class="text-sky-900 font-medium">{regionSea}</p>
                            <p class="text-xs text-sky-600 mt-1">
                                共 {topicStats.count} 個浪點 · 新手友善 {topicStats.beginner} 個
                                {seaUpdated && <> · 海況資料更新於 {seaUpdated}</>}
                            </p>
                        </div>
                    </div>
                )}

                {/* 🟢 [Slug-specific enhancement] 僅 taichung-surf-school 顯示，
                     針對「台中衝浪教學/課程/教練」commercial intent 補充的
                     Information Gain 內容，不影響其他 topic 頁。 */}
                {isTaichungSurfSchool && (
                    <div class="mb-8 bg-white rounded-2xl p-6 md:p-8 border border-stone-100 shadow-sm space-y-6">
                        <div>
                            <h2 class="text-xl font-bold text-stone-800 mb-2">台中適合學衝浪嗎？</h2>
                            <p class="text-stone-600 leading-relaxed">
                                台中目前收錄的 {pageSpots.length} 個浪點（{pageSpots.map((s: Spot, i: number) => (
                                    <>
                                        <a href={`/spot/${s.name}/`} class="text-sky-700 underline hover:text-sky-900">{s.name}</a>
                                        {i < pageSpots.length - 1 ? '、' : ''}
                                    </>
                                ))}）都是沙岸地形、浪況平緩，且現場都有衝浪店與租板服務，方便新手第一次下水前準備裝備（實際是否提供教學課程請以店家現場資訊為準），對完全沒經驗的新手來說是相對容易入門的環境。但浪點數量不多、浪型也偏單一，如果你已經有基礎、想挑戰不同地形或浪況，台中不會是首選。
                            </p>
                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-stone-800 mb-2">適合哪些人在台中上課？</h2>
                            <p class="text-stone-600 leading-relaxed">
                                最適合完全新手、想安全體驗一次衝浪、或人在中部想就近上課的人。地形平緩加上有現場店家支援，第一次下水的門檻較低。若目標是練習進階技巧或追求變化較大的浪型，通常會需要往浪點選擇更多的地區移動。
                            </p>
                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-stone-800 mb-2">第一次上課，怎麼選課程與教練？</h2>
                            <ul class="list-disc list-inside text-stone-600 leading-relaxed space-y-1.5">
                                <li>教練是否會先教基本安全觀念與觀浪知識，而不是直接推下水</li>
                                <li>衝浪板、防寒衣、腳繩等裝備是否包含在課程內，或需要另外租借</li>
                                <li>上課地點是否就是實際下水的浪點，交通與停車是否方便</li>
                                <li>是團體課還是一對一教學，人數會直接影響教練能照顧到你的程度</li>
                            </ul>
                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-stone-800 mb-2">課程費用怎麼看？</h2>
                            <p class="text-stone-600 leading-relaxed">
                                預約前建議先確認費用是否包含教練指導、衝浪板、防磨衣或防寒衣、保險與交通接送；不同方案的包含項目可能不同，價格也會依課程長度與是否一對一而異。實際內容與費用請以報名頁面公告為準，本站不代為保證特定價格、教練資格或商家品質，僅提供地區與浪點資訊供參考。
                            </p>
                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-stone-800 mb-2">台中浪況要注意什麼？</h2>
                            <p class="text-stone-600 leading-relaxed">
                                台中目前收錄的浪點記錄的最佳 swell 方向多為{taichungSwellNote}，但實際浪況會依當天浪向、風向與浪高而不同，並非固定不變。建議上課前留意當日海況，浪況不穩定時不建議勉強下水，尤其是第一次上課的新手更要以安全為優先。
                            </p>
                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-stone-800 mb-2">台中浪點選擇不多，還有其他地方可以考慮嗎？</h2>
                            <p class="text-stone-600 leading-relaxed">
                                如果想要更多浪點或浪型選擇，地理上最順路的延伸是北邊的<a href="/city/苗栗縣/" class="text-sky-700 underline hover:text-sky-900">苗栗縣</a>，浪點數量明顯更多；也可以參考<a href="/guide/beginner/" class="text-sky-700 underline hover:text-sky-900">全台新手友善衝浪浪點清單</a>，比較其他地區的入門選擇。
                            </p>
                        </div>
                    </div>
                )}

                {/* 🟢 [變現] 新手主題 → 城市化衝浪課程 CTA */}
                {isBeginnerTopic && (
                    <SurfLessonCTA city={city || undefined} beginnerSpotNames={beginnerSpotNames} />
                )}

                {/* Spots Listing */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {pageSpots.map((spot, index) => {
                        // 🟢 [Ad Logic] 每 6 個插入一次廣告，且不佔兩欄
                        const showAd = (index + 1) % 6 === 0;
                        
                        return (
                            <>
                                {/* 1. 渲染浪點卡片 */}
                                <SpotCard spot={spot} />

                                {/* 2. Feature 1 手機版購物車 (Mobile In-Feed Injection) */}
                                {index === 1 && (
                                    <div class="md:col-span-2 lg:hidden my-4">
                                        <GearChecklist spot={{ 
                                            difficulty: '初學者', 
                                            bottom_type: '沙灘', 
                                            tags: ['新手', '防曬'] 
                                        }} />
                                    </div>
                                )}

                                {/* 3. Feature 2 廣告 (Native Ad) */}
                                {showAd && (
                                    <NativeAdCard adData={adRotator.next()} />
                                )}
                            </>
                        );
                    })}
                </div>

                {/* Empty State Fallback (Should be rare due to getStaticPaths filtering) */}
                {pageSpots.length === 0 && (
                    <div class="text-center py-20 bg-white rounded-2xl border border-stone-100 shadow-sm">
                        <p class="text-stone-500 text-lg">目前沒有符合條件的浪點資料。</p>
                        <a href="/" class="inline-block mt-4 text-sky-600 font-bold hover:underline">
                            回首頁瀏覽更多
                        </a>
                    </div>
                )}

                {/* 🟢 [Data-Driven] 浪點比較表(難度/底質/最佳浪向/今日浪高) */}
                {pageSpots.length > 1 && (
                    <div class="mt-12">
                        <h2 class="text-xl font-bold text-stone-800 mb-2">浪點比較表</h2>
                        <SpotCompareTable spots={pageSpots} waves={topicWaves} />
                    </div>
                )}

                {/* 🟢 [Content Depth] FAQ Section */}
                {faqItems.length > 0 && (
                <div class="mt-12 bg-white rounded-2xl p-8 border border-stone-100 shadow-sm">
                    <h2 class="text-2xl font-bold text-stone-800 mb-6">關於「{title}」的常見問題</h2>
                    <ul class="space-y-6">
                        {faqItems.map(item => (
                            <li>
                                <h3 class="font-bold text-sky-700 text-lg mb-2">{item.question}</h3>
                                <p class="text-stone-600 leading-relaxed" set:html={item.answer}></p>
                            </li>
                        ))}
                    </ul>
                </div>
                )}
            </div>

            {/* Sidebar (Occupies 1 col) */}
            <aside class="lg:col-span-1 space-y-8 hidden lg:block">
                <div class="sticky top-24">
                    <GearChecklist spot={{ 
                        difficulty: '初學者', 
                        bottom_type: '沙灘', 
                        tags: ['新手', '防曬'] 
                    }} />

                   <div class="mt-8">
                        <NativeAdCard adData={adRotator.next()} />
                   </div>
                </div>
            </aside>
        
        </div>
    </div>
  </div>
</Layout>
