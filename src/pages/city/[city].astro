---
import Layout from '../../layouts/Layout.astro';
import SpotCard from '../../components/SpotCard.astro';
import spots from '../../data/surf_spots.json';

export async function getStaticPaths() {
  const cities = [...new Set(spots.map((s) => s.city))];
  return cities.map((city) => ({
    params: { city },
    props: { city },
  }));
}

const { city } = Astro.props;
const citySpots = spots.filter(s => s.city === city);

const title = `${city}衝浪地點推薦 - 共 ${citySpots.length} 個熱門浪點`;
const description = `精選 ${city} 衝浪點推薦，包含新手浪點、教學點。提供即時浪況與交通資訊。`;

// Schema.org
const citySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首頁",
          "item": Astro.site ? Astro.site.origin : "https://surftaiwan.url"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": city,
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": Astro.url.href
    },
    {
      "@type": "ItemList",
      "name": `${city}衝浪點列表`,
      "itemListElement": citySpots.map((spot, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `${Astro.site ? Astro.site.origin : ''}/spot/${spot.name}`,
        "name": spot.name
      }))
    }
  ]
};
---

<Layout title={title} description={description}>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(citySchema)}></script>

    <div class="bg-indigo-50 border-b border-indigo-100 py-10 mb-8">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-3xl font-black text-indigo-900 mb-2">{city}衝浪地圖</h1>
            <p class="text-indigo-600 font-medium">
                收錄 {citySpots.length} 個絕佳浪點，適合各種程度的浪人
            </p>
        </div>
    </div>

    <div class="container mx-auto px-4 pb-16">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {citySpots.map(spot => (
                <SpotCard spot={spot} />
            ))}
        </div>
    </div>
</Layout>
