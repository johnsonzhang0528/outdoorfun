---
import Layout from '../../layouts/Layout.astro';
import SpotCard from '../../components/SpotCard.astro';
import NativeAdCard from '../../components/NativeAdCard.astro';
import spots from '../../data/surf_spots.json';
import { getValidSpots } from '../../utils/filterSpots';
import { getAdRotator } from '../../utils/adManager';

export async function getStaticPaths() {
  const validSpots = getValidSpots(spots);
  const cities = [...new Set(validSpots.map((s) => s.city))];
  return cities.map((city) => ({
    params: { city },
    props: { city },
  }));
}

const { city } = Astro.props;
const validSpots = getValidSpots(spots);
const citySpots = validSpots.filter(s => s.city === city);
const adRotator = getAdRotator();

// 🟢 [SEO] Auto-Generated Statistical Summary
const beginnerCount = citySpots.filter(s => s.difficulty === '初學者').length;
const expertCount = citySpots.filter(s => s.difficulty === '專家').length;
const featuresList = [...new Set(citySpots.flatMap(s => s.features || []))].slice(0, 3).join('、');

const summaryText = `精選 ${citySpots.length} 個${city}衝浪地標。其中包含 ${beginnerCount} 個適合初學者的浪點${expertCount > 0 ? `與 ${expertCount} 個挑戰級進階點` : ''}。${featuresList ? `多數地點具備${featuresList}等設施，` : ''}是體驗台灣衝浪文化的絕佳選擇。`;

// 🟢 [SEO Integration] Opportunity B: Real-time Condition Keywords
const title = `${city}衝浪地圖 - 共 ${citySpots.length} 個熱門浪點 (今日即時浪況)`;
const description = `精選 ${city} 衝浪點推薦，包含新手浪點、教學點。提供今日即時浪況、風速情報與交通資訊，助您掌握最佳下水時機。`;

// 🟢 [SEO] FAQ Logic
const beginnerSpots = citySpots.filter(s => s.difficulty === '初學者');
const showerSpots = citySpots.filter(s => s.features && (s.features.includes('淋浴') || s.features.includes('沖洗')));
const parkingSpots = citySpots.filter(s => s.features && s.features.includes('停車場'));

const faqItems = [];

if (beginnerSpots.length > 0) {
    faqItems.push({
        question: `${city}最適合新手的衝浪點是哪裡？`,
        answer: `${city}適合初學者的浪點包含：${beginnerSpots.map(s => `<a href="/spot/${s.name}">${s.name}</a>`).join('、')}。這些地點通常地形較為平緩，適合新手體驗與學習。`
    });
}

if (showerSpots.length > 0) {
    faqItems.push({
        question: `${city}有哪些浪點具備淋浴設施？`,
        answer: `${city}提供淋浴或沖洗設施的浪點有：${showerSpots.map(s => `<a href="/spot/${s.name}">${s.name}</a>`).join('、')}。建議前往前確認設施開放時間。`
    });
} else if (parkingSpots.length > 0) {
     faqItems.push({
        question: `${city}哪些衝浪點好停車？`,
        answer: `${city}設有停車場的便利浪點包含：${parkingSpots.map(s => `<a href="/spot/${s.name}">${s.name}</a>`).join('、')}。`
    });
}

// 🟢 [SEO] Coastline Navigation (Neighboring Cities)
const NEIGHBORS: Record<string, { prev: string; next: string }> = {
    // East Coast (North to South)
    "新北市": { prev: "基隆市", next: "宜蘭縣" },
    "宜蘭縣": { prev: "新北市", next: "花蓮縣" },
    "花蓮縣": { prev: "宜蘭縣", next: "台東縣" },
    "台東縣": { prev: "花蓮縣", next: "屏東縣" },
    // South & West (South to North)
    "屏東縣": { prev: "台東縣", next: "高雄市" },
    "高雄市": { prev: "屏東縣", next: "台南市" },
    "台南市": { prev: "高雄市", next: "嘉義縣" },
    // Others
    "基隆市": { prev: "新北市", next: "新北市" }, // Dead end loop
};

const neighbors = NEIGHBORS[city];

// Schema.org
const baseSchema = [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首頁",
          "item": Astro.site ? Astro.site.origin : "https://surftaiwan.url"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": city,
          "item": Astro.url.href
        }
      ]
    }, // ... existing items ...
];

const citySchema = {
  "@context": "https://schema.org",
  "@graph": [
    ...baseSchema[0].itemListElement ? [baseSchema[0]] : [], // Fallback if structure changes, but let's rewrite cleanly below
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首頁",
          "item": Astro.site ? Astro.site.origin : "https://surftaiwan.url"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": city,
          "item": Astro.url.href
        }
      ]
    },
    {
      "@type": "CollectionPage",
      "name": title,
      "description": description,
      "url": Astro.url.href
    },
    {
      "@type": "ItemList",
      "name": `${city}衝浪點列表`,
      "itemListElement": citySpots.map((spot, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": `${Astro.site ? Astro.site.origin : ''}/spot/${spot.name}`,
        "name": spot.name
      }))
    },
    ...(faqItems.length > 0 ? [{
        "@type": "FAQPage",
        "mainEntity": faqItems.map(item => ({
            "@type": "Question",
            "name": item.question,
            "acceptedAnswer": {
                "@type": "Answer",
                "text": item.answer
            }
        }))
    }] : [])
  ]
};
---

<Layout title={title} description={description} geo={{ placename: city }}>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(citySchema)}></script>

    <div class="bg-indigo-50 border-b border-indigo-100 py-10 mb-8">
        <div class="container mx-auto px-4 text-center">
            <h1 class="text-3xl font-black text-indigo-900 mb-2">{city}衝浪地圖</h1>
            <p class="text-indigo-600 font-medium max-w-2xl mx-auto leading-relaxed">
                {summaryText}
            </p>
        </div>
    </div>

    <div class="container mx-auto px-4 pb-16">
        {/* 🟢 [SEO] Semantic Heading for List */}
        <h2 class="sr-only">精選{city}浪點列表</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {citySpots.map((spot, index) => {
                const showAd = (index + 1) % 6 === 0;
                return (
                    <div class="flex flex-col h-full">
                        <SpotCard spot={spot} />
                        {showAd && (
                            <div class="mt-6 flex-1">
                                <NativeAdCard adData={adRotator.next()} />
                            </div>
                        )}
                    </div>
                );
            })}
        </div>

        {/* 🟢 [Content Depth] Automated FAQ Section */}
        {faqItems.length > 0 && (
            <div class="mt-16 max-w-3xl mx-auto">
                <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">關於 {city} 衝浪常見問題</h2>
                <div class="space-y-6">
                    {faqItems.map((item) => (
                        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
                            <h3 class="text-lg font-bold text-indigo-900 mb-2 flex items-start">
                                <span class="bg-indigo-100 text-indigo-600 rounded-full w-6 h-6 flex items-center justify-center text-sm mr-2 mt-0.5 flex-shrink-0">Q</span>
                                {item.question}
                            </h3>
                            <div class="pl-8 text-gray-600 leading-relaxed" set:html={item.answer}></div>
                        </div>
                    ))}
                </div>
            </div>
        )}

        {/* 🟢 [SEO] Coastline Navigation (Neighboring Cities) */}
        {neighbors && (
            <div class="mt-12 bg-indigo-900 rounded-2xl p-8 text-center text-white relative overflow-hidden">
                <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')]"></div>
                
                <h3 class="text-xl md:text-2xl font-bold mb-6 relative z-10">
                    🏄‍♂️ 探索台灣海岸線
                </h3>
                
                <div class="flex flex-col md:flex-row justify-center items-center gap-6 relative z-10">
                    <a href={`/city/${neighbors.prev}`} class="group flex items-center bg-indigo-800 hover:bg-indigo-700 px-6 py-3 rounded-lg transition-colors border border-indigo-700">
                        <span class="mr-3 text-indigo-300 group-hover:-translate-x-1 transition-transform">←</span>
                        <div class="text-left">
                            <div class="text-xs text-indigo-300 font-bold uppercase tracking-wider">往北/往西</div>
                            <div class="font-bold text-lg">{neighbors.prev}</div>
                        </div>
                    </a>

                    <div class="hidden md:block w-px h-12 bg-indigo-700"></div>

                    <a href={`/city/${neighbors.next}`} class="group flex items-center bg-indigo-800 hover:bg-indigo-700 px-6 py-3 rounded-lg transition-colors border border-indigo-700">
                        <div class="text-right">
                             <div class="text-xs text-indigo-300 font-bold uppercase tracking-wider">往南/往東</div>
                             <div class="font-bold text-lg">{neighbors.next}</div>
                        </div>
                        <span class="ml-3 text-indigo-300 group-hover:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
                
                <p class="mt-6 text-indigo-300 text-sm">
                   衝完{city}還不夠？沿著海岸線繼續探索鄰近的浪點生活圈。
                </p>
            </div>
        )}
    </div>
</Layout>
