---
import Layout from '../layouts/Layout.astro';
import SpotCard from '../components/SpotCard.astro';
import spots from '../data/surf_spots.json';

// Random 3 spots
const randomSpots = spots.sort(() => 0.5 - Math.random()).slice(0, 3);
---

<Layout title="404 找不到頁面 | Surf Taiwan">
  <div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4 py-20">
    <div class="mb-8 text-8xl">🏄</div>
    <h1 class="text-6xl font-extrabold text-sky-600 mb-4">404</h1>
    <h2 class="text-2xl md:text-3xl font-bold text-stone-800 mb-6">哎呀！找不到這個浪點</h2>
    <p class="text-lg text-stone-600 max-w-lg mb-8">
      您要找的頁面可能已經移除或暫時無法存取。<br/>
      不過別擔心，這裡有幾個熱門浪點推薦給您：
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full max-w-5xl mb-12 text-left">
        {randomSpots.map(spot => (
            <SpotCard spot={spot} />
        ))}
    </div>

    <a href="/" class="bg-sky-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-sky-700 transition shadow-lg active:scale-95">
      回首頁探索更多
    </a>
  </div>
</Layout>
