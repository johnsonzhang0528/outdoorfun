---
import Layout from '../../layouts/Layout.astro';
import CampMap from '../../components/CampMap.astro';
import GearChecklist from '../../components/GearChecklist.astro';
import BaseShareButtons from '../../components/ShareButtons.astro';
import CampgroundCard from '../../components/CampgroundCard.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';
import campgrounds from '../../data/campgrounds_enriched.json';
import productData from '../../data/products.json';
import weatherData from '../../data/weather_forecast.json';

export async function getStaticPaths() {
  return campgrounds.map((camp) => ({
    params: { name: camp.name },
    props: { camp },
  }));
}


const { camp } = Astro.props;
const campWeather = weatherData[camp.name] || [];
const weatherMeta = weatherData["_metadata"] || {};

// Release Date Logic (Big Bang Launch - All Pages Live)
// 策略調整：與其分批上線，不如一次性全量釋出，建立完整的內部連結網 (Hub & Spoke Integrity)。
// 這也符合老域名 (Aged Domain) 回歸的訊號。
const shouldIndex = true; 

// SEO Dates Strategy
// datePublished: 使用資料庫中的原始發布時間 (release_date)，確保 "First Seen" 時間點穩定，避免每次 Build 都改變。
// dateModified: 使用 Build Time (new Date())，代表「最近一次驗證/更新資料」的時間，這對目錄型網站是合理的 (Verified Freshness)。
const publishedTime = camp.release_date ? new Date(camp.release_date).toISOString() : new Date().toISOString();
const modifiedTime = new Date().toISOString();

// Affiliate Logic Helpers
const isHighAltitude = camp.elevation > 1000;
const isGlamping = camp.features.has_glamping;
const isTraditional = !isGlamping; // Helper for Traditional Camps

// 🟢 [Configuration] Affiliate Configuration
// (Removed legacy affiliate config)

// 🏕️ Facilities & Features Configuration
const FACILITIES_MAPPING = [
    // Hardware / Equipment (Infer from Description or Tags)
    { key: "fridge", keywords: ["冰箱", "冷藏", "冷凍"], icon: "❄️", label: "提供冰箱" },
    { key: "water_dispenser", keywords: ["飲水機"], icon: "💧", label: "飲水機" },
    { key: "wifi", keywords: ["wifi", "網路", "訊號", "4G", "5G"], icon: "📶", label: "Wifi/訊號" },
    { key: "power", keywords: ["供電", "插座", "電源"], icon: "⚡", label: "營位供電" },
    { key: "bathroom", keywords: ["衛浴", "廁所", "淋浴", "吹風機"], icon: "🚿", label: "衛浴/吹風機" },
    { key: "parking", keywords: ["停車"], icon: "🅿️", label: "停車場" },

    // Camp Type / Environment (From Tags)
    { key: "roof", keywords: ["雨棚"], icon: "🏠", label: "雨棚營位" },
    { key: "deck", keywords: ["棧板"], icon: "🪵", label: "棧板營位" },
    { key: "grass", keywords: ["草地", "草皮"], icon: "🌱", label: "草地營位" },
    { key: "gravel", keywords: ["碎石"], icon: "🪨", label: "碎石營位" },
    { key: "forest", keywords: ["森林", "樹林"], icon: "🌲", label: "森林系" },
    { key: "stream", keywords: ["溪流", "玩水", "戲水"], icon: "🌊", label: "戲水/溪流" },
    
    // Activities / Vibe (From Tags)
    { key: "firefly", keywords: ["螢火蟲"], icon: "✨", label: "螢火蟲季節" },
    { key: "sakura", keywords: ["櫻花"], icon: "🌸", label: "櫻花季節" },
    { key: "cloud", keywords: ["雲海"], icon: "☁️", label: "雲海景觀" },
    { key: "night_view", keywords: ["夜景"], icon: "🌃", label: "百萬夜景" },
    { key: "stars", keywords: ["星空", "觀星"], icon: "✨", label: "觀星" },
    { key: "sand", keywords: ["沙坑"], icon: "🏖️", label: "兒童沙坑" },
];

// Helper to determine active facilities
const getFacilities = () => {
    const activeFacilities = [];
    const searchContext = (camp.description + camp.tags.join(' ')).toLowerCase();

    // 1. Check Keywords
    FACILITIES_MAPPING.forEach(fac => {
        if (fac.keywords.some(k => searchContext.includes(k.toLowerCase()))) {
            activeFacilities.push(fac);
        }
    });

    // 2. Add Explicit Feature Flags if not already present
    if (camp.features.pet_friendly && !activeFacilities.find(f => f.label === "寵物友善")) {
        activeFacilities.push({ icon: "🐾", label: "寵物友善" });
    }
    if (camp.features.high_altitude && !activeFacilities.find(f => f.label.includes("海拔"))) {
        activeFacilities.push({ icon: "🏔️", label: "高海拔" });
    }
     if (camp.features.has_glamping && !activeFacilities.find(f => f.label === "豪華露營")) {
        activeFacilities.push({ icon: "⛺", label: "豪華露營" });
    }

    // Deduplicate by label
    return [...new Map(activeFacilities.map(item => [item.label, item])).values()];
};

const campFacilities = getFacilities();

// Weather Data (Removed duplicate declaration)

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "首頁",
      "item": "https://www.outdoorcampingworld.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": camp.city,
      "item": `https://www.outdoorcampingworld.com/city/${camp.city}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": camp.name,
      "item": `https://www.outdoorcampingworld.com/camp/${camp.name}`
    }
  ]
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": []
};

// 1. Generate FAQs from Facilities
campFacilities.forEach(fac => {
    faqSchema.mainEntity.push({
        "@type": "Question",
        "name": `請問${camp.name}有${fac.label.replace('提供', '')}嗎？`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `有的，${camp.name}配備有${fac.label}，提供露營者使用。`
        }
    });
});

// 2. Add Pet Friendly FAQ
if (camp.features.pet_friendly) {
    faqSchema.mainEntity.push({
        "@type": "Question",
        "name": `請問${camp.name}可以帶寵物嗎？`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": "是的，這裡是寵物友善營區，歡迎攜帶毛小孩一同同樂。"
        }
    });
}
// 3. Add High Altitude FAQ
if (camp.features.high_altitude) {
    faqSchema.mainEntity.push({
        "@type": "Question",
        "name": `請問${camp.name}的海拔大約多少？`,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": `這個營區位於海拔 ${camp.elevation} 公尺的高山區域，景色優美且氣候涼爽。`
        }
    });
}

// 🟢 [SEO] Optimized Page Title Logic
// Format: [Name] - [City][Area] | [Feature1], [Feature2] | [Year]最新路況
const currentYear = new Date().getFullYear();
const featureList = [];
if (camp.features.high_altitude) featureList.push(`海拔${camp.elevation}m`);
if (camp.features.has_glamping) featureList.push("豪華露營");
if (camp.features.pet_friendly) featureList.push("寵物友善");
if (camp.tags.includes("雲海")) featureList.push("雲海");
if (camp.tags.includes("櫻花")) featureList.push("櫻花季");

// Add generic tags if we don't have enough features
if (featureList.length < 2 && camp.tags.length > 0) {
    featureList.push(camp.tags[0]);
}

const seoTitleFeatures = featureList.slice(0, 3).join('、');
const seoTitle = `${camp.name} - ${camp.city}${camp.area} | ${seoTitleFeatures} | ${currentYear}最新路況`;

// 🟢 [SEO] Content Enrichment (Keyword Density Injector)
// 擴寫原始描述，自然置入高權重關鍵字 (City, Area, Elevation, Features)
const baseDesc = camp.description.replace(/\n/g, ' ');
const keywords = [
    `${camp.city}${camp.area}露營`,
    camp.features.high_altitude ? `海拔${camp.elevation}公尺` : null,
    camp.features.has_glamping ? '豪華露營(Glamping)' : '熱門露營區',
    camp.features.pet_friendly ? '寵物友善' : null,
    ...camp.tags.slice(0, 3)
].filter(Boolean).join('、');

const richDescription = `【${camp.name}】是位於${camp.city}${camp.area}的${camp.features.has_glamping ? '豪華露營聖地' : '推薦露營區'}。${baseDesc} 提供${keywords}等優質體驗，${currentYear}年最新路況與訂位資訊請參考詳細介紹。`;

// 🟢 [Social SEO] Define Share Image
// 策略優先級 (Fallback Strategy):
// 1. 營區專屬圖片 (若資料庫 camp.image 欄位有值)
// 2. Unsplash 隨機情境圖 (根據 tags 自動產生，解決無圖的空窗期)
// 3. 若以上皆無 (設為 undefined)，Layout 元件會自動退回使用全站預設圖 (/social-card.webp)
// const randomCover = `https://source.unsplash.com/800x600/?camping,${camp.tags.includes('豪華露營') ? 'glamping' : 'tent'}`;
const shareImage = camp.image;
// 若您希望「沒有專屬圖就直接顯示全站預設圖(不要隨機圖)」，請改為: const shareImage = camp.image;

const schemaData = {
  "@type": "Campground",
  "name": camp.name,
  "description": richDescription,
  // 🟢 [SEO] Add explicit image property (Google Requirement for LocalBusiness)
  "image": [
    shareImage
  ],
  "telephone": camp.phone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": camp.address,
    "addressLocality": camp.area,
    "addressRegion": camp.city,
    "addressCountry": "TW"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": camp.lat,
    "longitude": camp.lng,
    "elevation": camp.elevation
  },
  "priceRange": "$$"
};

// 🟢 [SEO] Consolidated Graph Schema
// Combining Campground, Breadcrumb, and FAQ into one graph for better entity relation understanding by Google
const schemas = {
  "@context": "https://schema.org",
  "@graph": [
     schemaData,
     {
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "首頁", "item": "https://www.outdoorcampingworld.com" },
            { "@type": "ListItem", "position": 2, "name": camp.city, "item": `https://www.outdoorcampingworld.com/city/${camp.city}` },
            { "@type": "ListItem", "position": 3, "name": camp.name, "item": `https://www.outdoorcampingworld.com/camp/${camp.name}` }
        ]
     },
     faqSchema
  ]
};

// 🟢 [SEO] Internal Linking: Nearby Campgrounds (Haversine Distance)
function getDistance(lat1, lon1, lat2, lon2) {
  const R = 6371; // Radius of the earth in km
  const dLat = deg2rad(lat2 - lat1);
  const dLon = deg2rad(lon2 - lon1); 
  const a = 
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(deg2rad(lat1)) * Math.cos(deg2rad(lat2)) * 
    Math.sin(dLon / 2) * Math.sin(dLon / 2); 
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)); 
  const d = R * c; // Distance in km
  return d;
}

function deg2rad(deg) {
  return deg * (Math.PI/180);
}

// Calculate distance for all camps (excluding current)
const nearbyCamps = campgrounds
    .filter(c => c.name !== camp.name && c.lat && c.lng)
    .map(c => ({
        ...c,
        distance: getDistance(camp.lat, camp.lng, c.lat, c.lng)
    }))
    .sort((a, b) => a.distance - b.distance)
    .slice(0, 6); // Take top 5 closest (6 to fill grid neatly if needed)

const relatedCamps = nearbyCamps;
---

<Layout title={seoTitle} description={richDescription} image={shareImage}>
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(schemas)}></script>
    
    {/* PSEO Drip Feed Control */}
    {!shouldIndex && <meta name="robots" content="noindex, nofollow" slot="head" />}
    
    {/* Hero Section - Mobile First Design */}
    <div class="bg-stone-100 border-b border-stone-200">
        <div class="container mx-auto px-4 py-3 text-sm text-stone-500">
            <a href="/" class="hover:text-emerald-700">首頁</a> &rsaquo; 
            <a href={`/city/${camp.city}`} class="hover:text-emerald-700 mx-1">{camp.city}</a> &rsaquo;
            <span class="mx-1">{camp.area}</span> &rsaquo; 
            <span class="text-stone-800 font-medium">{camp.name}</span>
        </div>
    </div>

    <div class="container mx-auto px-4 py-8 md:py-12 pb-24 md:pb-12">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
            
            {/* Main Content (Left Column) */}
            <div class="lg:col-span-2">
                <header class="mb-6 md:mb-8">
                    <div class="flex flex-wrap items-center gap-3 mb-3">
                         {/* 🟢 [NEW] Today's Weather Summary Badge */}
                         {campWeather.length > 0 && (
                            <span class="inline-flex items-center gap-1.5 bg-stone-50 border border-stone-200 text-stone-700 text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                                <span>{campWeather[0].max_temp}°C</span>
                                <span class="text-stone-300">|</span>
                                <span>{campWeather[0].label}</span>
                            </span>
                        )}
                        {camp.features.high_altitude && <span class="bg-blue-600 text-white text-xs font-bold px-2 py-1 rounded">高海拔 {camp.elevation}m</span>}
                        {camp.features.has_glamping && <span class="bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded">豪華露營</span>}
                        {camp.features.pet_friendly && <span class="bg-emerald-600 text-white text-xs font-bold px-2 py-1 rounded">寵物友善</span>}
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-stone-900 mb-2">{camp.name}</h1>
                    <div class="flex items-center text-stone-600 text-sm md:text-base gap-4">
                        <span class="flex items-center gap-1"><span class="text-xl">📍</span> {camp.address}</span>
                    </div>

                    {/* 🟢 [NEW] Social Share Buttons - Viral Loop */}
                    <BaseShareButtons title={`【${camp.name}】${camp.city}${camp.area}露營區推薦`} />
                </header>

                {/* Map Component - Full width on mobile, top position */}
                <div class="bg-stone-200 rounded-2xl h-64 md:h-96 w-full mb-8 relative border border-stone-300 overflow-hidden shadow-inner group">
                   <CampMap lat={camp.lat} lng={camp.lng} name={camp.name} />
                   <a href={`https://www.google.com/maps/search/?api=1&query=${camp.lat},${camp.lng}`} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="absolute bottom-4 right-4 bg-white/95 backdrop-blur-sm px-4 py-2 rounded-lg shadow-lg text-sm font-bold text-emerald-700 hover:bg-emerald-50 transition flex items-center gap-2 z-[400] active:scale-95">
                        <span>🧭</span> Google 導航
                   </a>
                </div>

                {/* Weather Widget (Now Visible on both mobile and desktop in main column) */}
                <div class="mb-8">
                    <WeatherWidget forecast={campWeather} city={camp.city} updatedAt={weatherMeta.generated_at} />
                </div>

                {/* Description - Enhanced Typography */}
                <article class="prose prose-stone prose-lg md:prose-xl max-w-none mb-12 prose-headings:font-bold prose-p:text-stone-700 prose-a:text-emerald-600">
                    <h2 class="text-2xl font-bold text-stone-800 mb-4 border-l-4 border-emerald-500 pl-4">營區介紹</h2>
                    <p class="text-lg md:text-xl leading-relaxed text-stone-700 tracking-wide">{camp.description}</p>
                    
                    <div class="mt-8 flex flex-wrap gap-2 not-prose">
                        {camp.tags.map(tag => (
                            <span class="bg-stone-100 text-stone-600 px-3 py-1.5 rounded-full text-base border border-stone-200">
                                #{tag}
                            </span>
                        ))}
                    </div>

                    {/* ✨ New Section: Camp Facilities & Features */}
                    {campFacilities.length > 0 && (
                        <div class="mt-10 p-6 bg-stone-50 rounded-2xl border border-stone-200">
                            <h3 class="text-xl font-bold text-stone-800 mb-4 flex items-center gap-2">
                                <span>🏕️</span> 營區特色與設備
                            </h3>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                                {campFacilities.map(fac => (
                                    <div class="flex items-center gap-2 text-stone-700 bg-white px-3 py-2 rounded-lg border border-stone-100 shadow-sm">
                                        <span class="text-lg">{fac.icon}</span>
                                        <span class="font-medium">{fac.label}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </article>

                {/* 🟢 [RESTORED] Info Cards (Old Version Style) */}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-12">
                    <div class="bg-emerald-50 p-6 rounded-xl border border-emerald-100">
                        <h3 class="font-bold text-emerald-800 mb-4 flex items-center gap-2">
                            <span>📞</span> 聯絡資訊
                        </h3>
                        <p class="text-emerald-900 font-medium text-lg mb-2">{camp.phone || "請依現場公告為主"}</p>
                        <p class="text-sm text-emerald-700">建議預訂前先致電確認營況</p>
                    </div>
                    <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
                        <h3 class="font-bold text-blue-800 mb-4 flex items-center gap-2">
                            <span>⛰️</span> 地理環境
                        </h3>
                        <div class="flex justify-between items-center border-b border-blue-200 pb-2 mb-2">
                            <span class="text-blue-700">海拔高度</span>
                            <span class="font-bold text-blue-900">{camp.elevation} 公尺</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-blue-700">所在區域</span>
                            <span class="font-bold text-blue-900">{camp.city} {camp.area}</span>
                        </div>
                    </div>
                </div>

                {/* 🟢 [RESTORED] Nearby Camps - Internal Linking */}
                {relatedCamps.length > 0 && (
                    <div class="border-t border-stone-200 pt-10">
                        <h3 class="text-2xl font-bold text-stone-800 mb-6 flex items-center gap-2">
                           <span>📍</span> 推薦附近的其他露營區
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                             {relatedCamps.map(related => (
                                 <CampgroundCard camp={related} />
                             ))}
                        </div>
                    </div>
                )}
            </div>

            {/* Sidebar (Right Column) */}
             <aside class="space-y-6 lg:col-span-1">
                 {/* Gear Checklist (Now in Sidebar) */}
                 <div class="sticky top-24 z-10 space-y-6">
                     <GearChecklist tags={camp.tags} elevation={camp.elevation} />
                 </div>
            </aside>

        </div>
    </div>

    {/* Sticky Bottom Bar for Mobile Conversion */}
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-stone-200 p-4 pb-safe z-50 md:hidden shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)]">
        <div class="grid grid-cols-5 gap-4 items-center h-12">
            <div class="col-span-2 text-xs text-stone-500">
                <p>每晚參考價</p>
                <p class="text-lg font-bold text-red-600">NT$ 1200 <span class="text-xs font-normal text-stone-400">起</span></p>
            </div>
            <a href="#" class="col-span-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg h-full flex items-center justify-center shadow-md active:scale-95 transition-transform">
                前往預訂 / 查看優惠
            </a>
        </div>
    </div>
</Layout>
