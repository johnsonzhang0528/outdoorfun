        <script is:inline src="https://www.conn.tw/track/script/oeya_member_url.js" defer></script>

<script>
            // 🪙 Global Affiliate Link Rewriter
            const ICHANNELS_PREFIX = "https://product.mchannles.com/redirect_wa.php?k=3F8Gh&tourl=";
            const TARGET_DOMAINS = ["momoshop.com.tw", "klook.com"];
            function processAffiliateLink(anchor) {
                if (!anchor || !anchor.href) return;
                const url = anchor.href;
                if (url.includes('product.mchannles.com')) return;
                const isTargetDomain = TARGET_DOMAINS.some(domain => url.includes(domain));
                if (isTargetDomain) {
                    anchor.href = `${ICHANNELS_PREFIX}${encodeURIComponent(url)}`;
                    anchor.rel = "nofollow sponsored";
                    anchor.target = "_blank";
                }
            }

            function initAffiliateLinks() {
                document.querySelectorAll('a[href^="http"]').forEach(processAffiliateLink);
            }

            const adObserver = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    mutation.addedNodes.forEach((node) => {
                        if (node.nodeType === 1) {
                             const el = node; 
                             if (el.tagName === 'A') processAffiliateLink(el);
                             if (el.querySelectorAll) {
                                 el.querySelectorAll('a[href^="http"]').forEach(processAffiliateLink);
                             }
                        }
                    });
                });
            });
            function startObserver() {
                initAffiliateLinks();
                adObserver.disconnect();
                adObserver.observe(document.body, { childList: true, subtree: true });
            }

            document.addEventListener('astro:page-load', startObserver);
            document.addEventListener('DOMContentLoaded', startObserver);
        </script>
</body>
