        <script is:inline src="https://www.conn.tw/track/script/oeya_member_url.js" defer></script>

<script>
            // 🪙 Global Affiliate Link Rewriter
            const ICHANNELS_PREFIX = "https://product.mchannles.com/redirect_wa.php?k=3F8Gh&tourl=";
            const TARGET_DOMAINS = ["momoshop.com.tw", "klook.com"];
            function processAffiliateLink(anchor) {
                if (!anchor || !anchor.href) return;
                const url = anchor.href;
                if (url.includes('product.mchannles.com')) return;
                const isTargetDomain = TARGET_DOMAINS.some(domain => url.includes(domain));
                if (isTargetDomain) {
                    anchor.href = `${ICHANNELS_PREFIX}${encodeURIComponent(url)}`;
                    anchor.rel = "nofollow sponsored";
                    anchor.target = "_blank";
                }
            }

            function initAffiliateLinks() {
                document.querySelectorAll('a[href^="http"]').forEach(processAffiliateLink);
            }

            const adObserver = new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    mutation.addedNodes.forEach((node) => {
                        if (node.nodeType === 1) {
                             const el = node; 
                             if (el.tagName === 'A') processAffiliateLink(el);
                             if (el.querySelectorAll) {
                                 el.querySelectorAll('a[href^="http"]').forEach(processAffiliateLink);
                             }
                        }
                    });
                });
            });
            function startObserver() {
                initAffiliateLinks();
                adObserver.disconnect();
                adObserver.observe(document.body, { childList: true, subtree: true });
            }

            document.addEventListener('astro:page-load', startObserver);
            document.addEventListener('DOMContentLoaded', startObserver);
        </script>

<style>
	/* Global Styles */
	:root {
		--color-primary: #0ea5e9;
		--color-secondary: #64748b;
		--color-accent: #f97316;
		--color-background: #f8fafc;
		--color-surface: #ffffff;
		--color-error: #ef4444;
		--color-on-primary: #ffffff;
		--color-on-secondary: #ffffff;
		--color-on-accent: #ffffff;
		--color-on-background: #111827;
		--color-on-surface: #111827;
		--color-on-error: #ffffff;
	}

	@font-face {
		font-family: 'Noto Sans TC';
		font-weight: 400;
		font-style: normal;
		font-display: swap; /* 🟢 [Performance] Avoid invisible text during load */
		src: url('/fonts/NotoSansTC-Regular.woff2') format('woff2'),
			 url('/fonts/NotoSansTC-Regular.woff') format('woff');
	}

	@font-face {
		font-family: 'Noto Sans TC';
		font-weight: 700;
		font-style: bold;
		font-display: swap; /* 🟢 [Performance] Avoid invisible text during load */
		src: url('/fonts/NotoSansTC-Bold.woff2') format('woff2'),
			 url('/fonts/NotoSansTC-Bold.woff') format('woff');
	}

	/* Base Styles */
	body {
		font-family: 'Noto Sans TC', sans-serif;
		line-height: 1.6;
		background-color: var(--color-background);
		color: var(--color-on-background);
		margin: 0;
		padding: 0;
	}

	h1, h2, h3, h4, h5, h6 {
		margin: 0;
		padding: 0;
		color: var(--color-on-surface);
	}

	a {
		color: var(--color-primary);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* Layout Styles */
	.flex {
		display: flex;
	}

	.grid {
		display: grid;
	}

	.hidden {
		display: none;
	}

	/* Print Styles */
	@media print {
		nav, footer, .js-feature-card, .share-buttons, #back-to-top, .no-print {
			display: none !important;
		}
		
		* {
			-webkit-print-color-adjust: exact !important;
			print-color-adjust: exact !important;
		}

		body, main {
			width: 100%;
			margin: 0;
			padding: 0;
			background: white;
			color: black;
		}

		/* Show URL after links */
		a[href^="http"]:after {
			content: " (" attr(href) ")";
			font-size: 0.8em;
			color: #666;
		}
		
		/* Clean up cards */
		.spot-card {
			break-inside: avoid;
			border: 1px solid #ddd;
			box-shadow: none;
			padding: 1rem;
			margin-bottom: 1rem;
		}
	}
</style>
</body>
</html>
