---
// src/layouts/Layout.astro

import MobileHeader from '../components/MobileHeader.astro';
import BackToTop from '../components/BackToTop.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
title: string;
description?: string;
noindex?: boolean;
    preloadImage?: string;
    omitSuffix?: boolean; // 🟢 [NEW] 控制是否省略標題後綴
    image?: string;       // 🟢 [NEW] 自訂 OG Image
    hideBottomNav?: boolean; // 🟢 [NEW] 特定頁面隱藏底部導航
}

const { 
    title, 
    description = "Surf Taiwan - 全台衝浪情報誌。收錄全台熱門浪點資訊、即時浪況預報、潮汐表，以及專業的衝浪裝備導購建議。",
    noindex = false,
    preloadImage,
    omitSuffix = false,
    image,
    hideBottomNav = false
} = Astro.props;

const pageTitle = omitSuffix ? title : `${title} | Surf Taiwan`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://surftaiwan.tw');
const socialImageURL = new URL(image || '/images/hero-bg-surf.jpg', Astro.url);
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
    const normalize = (p: string) => p.endsWith('/') && p.length > 1 ? p.slice(0, -1) : p;
    const current = normalize(currentPath);
    const target = normalize(path);
    return current === target || (target !== '/' && current.startsWith(target + '/'));
};
---

