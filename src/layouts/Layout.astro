---
// src/layouts/Layout.astro

import MobileHeader from '../components/MobileHeader.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
title: string;
description?: string;
noindex?: boolean;
    preloadImage?: string;
    omitSuffix?: boolean; // 🟢 [NEW] 控制是否省略標題後綴
    image?: string;       // 🟢 [NEW] 自訂 OG Image
}

const { 
    title, 
    description = "Surf Taiwan - 全台衝浪情報誌。收錄全台熱門浪點資訊、即時浪況預報、潮汐表，以及專業的衝浪裝備導購建議。",
    noindex = false,
    preloadImage,
    omitSuffix = false,
    image
} = Astro.props;

const pageTitle = omitSuffix ? title : `${title} | Surf Taiwan`;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image || '/images/hero-bg-surf.jpg', Astro.url);
---

<!doctype html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

        <link rel="preconnect" href="https://www.googletagmanager.com">
        <link rel="preconnect" href="https://www.conn.tw">
        <link rel="preconnect" href="https://www.transparenttextures.com">
<!-- 🟢 [Performance] Preconnect to Map Tilet Servers -->
    <link rel="preconnect" href="https://a.tile.openstreetmap.org" crossorigin />
    <link rel="preconnect" href="https://b.tile.openstreetmap.org" crossorigin />
    <link rel="preconnect" href="https://c.tile.openstreetmap.org" crossorigin />

        {/* 🟢 [LCP FIX] 加入 fetchpriority="high" 以消除 LCP 警告 */}
        <link 
            rel="preload" 
            href="https://www.transparenttextures.com/patterns/stardust.png" 
            as="image" 
            fetchpriority="high"
        />

        {preloadImage && (
            <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
        )}

{noindex ? (
<meta name="robots" content="noindex, nofollow" />
) : (
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}
{!noindex && <link rel="canonical" href={canonicalURL} />}

		<script is:inline>
            (function() {
                // 防止重複載入的旗標
                let gtmLoaded = false;
                const gtmId = '';

                function loadGTM() {
                    if (gtmLoaded) return;
                    gtmLoaded = true;

                    const script = document.createElement('script');
                    script.src = "https://www.googletagmanager.com/gtag/js?id=" + gtmId;
                    script.async = true;
                    document.head.appendChild(script);

                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', gtmId);
                }

                // 定義會觸發載入的「使用者互動」事件
                const userEvents = ['mousemove', 'click', 'keydown', 'scroll', 'touchstart'];
                
                function onUserInteraction() {
                    loadGTM();
                    // 觸發一次後，就移除所有監聽器，節省資源
                    userEvents.forEach(event => window.removeEventListener(event, onUserInteraction));
                }

                // 綁定事件監聽
                userEvents.forEach(event => window.addEventListener(event, onUserInteraction, { passive: true, once: true }));
                
                // 安全機制：如果使用者完全不動（例如掛網），5 秒後還是自動載入
                // 5 秒通常足夠避開 PSI 的關鍵檢測期
                setTimeout(loadGTM, 5000);
            })();
		</script>

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:site_name" content="Outdoor Camping World (台灣站)" />
<meta property="og:locale" content="zh_TW" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description.substring(0, 200)} />
<meta property="twitter:image" content={socialImageURL} />

{/* 🟢 [RESTORED] 恢復 ClientRouter 與 分潤變數 */}
<ClientRouter />
<script is:inline>
